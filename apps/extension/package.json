  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/logo": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.8.4",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^8.57.0",
    "tailwindcss": "^4.1.11",
