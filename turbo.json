{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "SKIP_BUILD",
        "HEADED",
        "SCREEN",
        "RECORD",
        "DISPLAY",
        "DEBUG_SW"
      ]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@repo/logo#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**"],
      "outputs": ["dist/**"]
    },
    "extension#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"]
    },
    "@repo/website#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**"]
    }
  }
}
